# ── SDC Secrets Template ──
# Copy to .env and fill in real values
# NEVER commit .env to git
# Usage: cp .env.example .env && nano .env

# ── Database ──
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://sdc:CHANGE_ME@localhost:5432/sdc

# ── Langfuse DB (internal) ──
LANGFUSE_DB_PASSWORD=CHANGE_ME

# ── Neo4j ──
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME

# ── Telegram Bots ──
AZTROTECH_BOT_TOKEN=CHANGE_ME
NOTIF_BOT_TOKEN=CHANGE_ME
NOTIF_OWNER_CHAT_ID=CHANGE_ME
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CEO_CHAT_ID=CHANGE_ME

# ── WhatsApp ──
WACLI_STORE=/home/mystic/.wacli/accounts/personal
WACLI_AUTH_TOKEN=CHANGE_ME
SDC_WA_API_KEY=CHANGE_ME

# ── OpenRouter / AI ──
OPENROUTER_API_KEY=CHANGE_ME

# ── Hermes ──
HERMES_API_KEY=CHANGE_ME

# ── MercadoPago ──
MERCADO_PAGO_ACCESS_TOKEN=CHANGE_ME

# ── NextAuth ──
NEXTAUTH_SECRET=CHANGE_ME

# ── Sonora Client ──
SONORA_CLIENT_SECRET=CHANGE_ME

# ── OpenClaw ──
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME

# ── n8n ──
N8N_BASIC_AUTH_USER=CHANGE_ME
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME

# ── Google (Calendar, Drive, Sheets) ──
GOOGLE_SHEETS_CONTENT_LOG_ID=CHANGE_ME
GOOGLE_DRIVE_BACKUP_FOLDER_ID=CHANGE_ME
