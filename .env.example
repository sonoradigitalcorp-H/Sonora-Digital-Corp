# ── SDC Secrets Template ──
# Copy to .env and fill in real values
# NEVER commit .env to git

# ── Database ──
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://sdc:CHANGE_ME@localhost:5432/sdc

# ── Telegram Bots ──
AZTROTECH_BOT_TOKEN=CHANGE_ME
NOTIF_BOT_TOKEN=CHANGE_ME
NOTIF_OWNER_CHAT_ID=CHANGE_ME

# ── OpenRouter / AI ──
OPENROUTER_API_KEY=CHANGE_ME

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME

# ── WhatsApp ──
WACLI_STORE=/home/mystic/.wacli/accounts/personal

# ── n8n ──
N8N_BASIC_AUTH_USER=CHANGE_ME
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME
