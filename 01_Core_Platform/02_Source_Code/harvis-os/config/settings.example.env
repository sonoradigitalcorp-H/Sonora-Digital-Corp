# Harvis OS Configuration

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
POSTGRES_URL=postgresql://harvis:harvis@localhost:5432/harvis

# Qdrant
QDRANT_URL=http://localhost:6333

# Neo4j
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=harvis

# Ollama (Local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Logging
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Agent Registry
AGENT_REGISTRY_URL=http://localhost:8001

# Event Bus
EVENT_BUS_STREAM=harvis:events
EVENT_BUS_GROUP=harvis:consumers

# Health Check
HEALTH_CHECK_INTERVAL=30

# Timeouts
MCP_TIMEOUT=30000
AGENT_TIMEOUT=600
