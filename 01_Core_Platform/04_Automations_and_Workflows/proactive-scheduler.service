[Unit]
Description=Hermes Proactive Morning Briefing
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/hermes
ExecStart=/usr/bin/python3 /opt/hermes/scripts/proactive_scheduler.py
Environment=VPS_HOST=45.90.108.12
Environment=HERMES_URL=http://127.0.0.1:8642
Environment=QDRANT_URL=http://127.0.0.1:6333
Environment=OLLAMA_URL=http://127.0.0.1:11434
EnvironmentFile=-/opt/hermes/.env
EnvironmentFile=-/home/mystic/.hermes/.env
StandardOutput=journal
StandardError=journal
TimeoutStartSec=120
Nice=10

[Install]
WantedBy=multi-user.target
