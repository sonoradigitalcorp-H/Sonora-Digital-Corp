import json
import os
import uuid
import jwt
import hashlib
from datetime import datetime, timedelta, timezone
from fastapi import FastAPI, HTTPException, Depends, status
from fastapi.middleware.cors import CORSMiddleware
from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials
from pydantic import BaseModel

app = FastAPI(title="ABE Music API", version="1.0.0")
security = HTTPBearer()

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

SECRET = os.environ.get("ABE_JWT_SECRET", "abe-dev-secret-2026")
DATA_DIR = "/home/ubuntu/abe-api/data"
os.makedirs(DATA_DIR, exist_ok=True)

def load_json(name):
    path = os.path.join(DATA_DIR, f"{name}.json")
    if os.path.exists(path):
        with open(path) as f:
            return json.load(f)
    return []

def save_json(name, data):
    path = os.path.join(DATA_DIR, f"{name}.json")
    with open(path, "w") as f:
        json.dump(data, f, indent=2, default=str)

def get_user(email):
    users = load_json("users")
    for u in users:
        if u["email"] == email:
            return u
    return None

def verify_token(cred: HTTPAuthorizationCredentials = Depends(security)):
    try:
        payload = jwt.decode(cred.credentials, SECRET, algorithms=["HS256"])
        return payload
    except jwt.PyJWTError:
        raise HTTPException(status_code=401, detail="Invalid token")

def admin_required(payload: dict = Depends(verify_token)):
    if payload.get("role") != "admin":
        raise HTTPException(status_code=403, detail="Admin required")
    return payload

# ====== Seed data ======
def seed():
    if not os.path.exists(os.path.join(DATA_DIR, "services.json")):
        save_json("services", [
            {"id":"1","title":"Digital Distribution","desc":"Multi-platform distribution to Spotify, Apple Music, TikTok, and 150+ streaming services.","icon":"🎵"},
            {"id":"2","title":"Artist Management","desc":"Full-service management including booking, marketing, and career strategy.","icon":"🎤"},
            {"id":"3","title":"Revenue Intelligence","desc":"Real-time royalty tracking, revenue analytics, and predictive modeling.","icon":"📊"},
            {"id":"4","title":"AI Content Factory","desc":"Automated music video production, visualizers, cover art, and social media content.","icon":"🎬"},
            {"id":"5","title":"Fan CRM","desc":"Fan engagement platform with email campaigns, analytics, and segmentation.","icon":"🤝"},
            {"id":"6","title":"Merch Store","desc":"Print-on-demand merch, digital products, and subscription management.","icon":"🛒"},
        ])
    if not os.path.exists(os.path.join(DATA_DIR, "artists.json")):
        save_json("artists", [
            {"id":"1","name":"Hector Rubio","streams":115000000,"label":"ABE Music Group","image":"🎸"},
            {"id":"2","name":"Jesus Urquijo","streams":4600000,"label":"ABE Music Group","image":"🎹"},
            {"id":"3","name":"Javier Arvayo","streams":50000,"label":"ABE Music Group","image":"🎤"},
        ])
    if not os.path.exists(os.path.join(DATA_DIR, "contacts.json")):
        save_json("contacts", [])
    if not os.path.exists(os.path.join(DATA_DIR, "users.json")):
        salt = hashlib.sha256(os.urandom(32)).hexdigest()[:16]
        pw = hashlib.pbkdf2_hmac("sha256", b"admin123", salt.encode(), 100000).hex()
        save_json("users", [
            {"email":"admin@abe.com","password":f"{salt}:{pw}","role":"admin","name":"Admin"},
            {"email":"demo@abe.com","password":f"{salt}:{pw}","role":"user","name":"Demo User"},
        ])

seed()

# ====== Models ======
class LoginRequest(BaseModel):
    email: str
    password: str

class ContactRequest(BaseModel):
    name: str
    email: str
    service: str = ""
    message: str = ""

class ServiceCreate(BaseModel):
    title: str
    description: str
    icon: str = "📦"

class ArtistCreate(BaseModel):
    name: str
    description: str = ""
    streams: int = 0

# ====== Auth ======
@app.post("/api/auth/login")
def login(req: LoginRequest):
    user = get_user(req.email)
    if not user:
        raise HTTPException(status_code=401, detail="Invalid credentials")
    stored = user["password"]
    salt, hashed = stored.split(":")
    pw = hashlib.pbkdf2_hmac("sha256", req.password.encode(), salt.encode(), 100000).hex()
    if pw != hashed:
        raise HTTPException(status_code=401, detail="Invalid credentials")
    token = jwt.encode({
        "email": user["email"],
        "role": user["role"],
        "name": user["name"],
        "exp": datetime.now(timezone.utc) + timedelta(days=7)
    }, SECRET, algorithm="HS256")
    return {"token": token, "user": {"email": user["email"], "name": user["name"], "role": user["role"]}}

@app.get("/api/me")
def get_me(payload: dict = Depends(verify_token)):
    return {"email": payload["email"], "role": payload["role"], "name": payload["name"]}

# ====== Stats ======
@app.get("/api/stats")
def get_stats():
    artists = load_json("artists")
    services = load_json("services")
    total = sum(a.get("streams", 0) for a in artists)
    return {"artists": len(artists), "total_streams": total, "services": len(services)}

# ====== Services ======
@app.get("/api/services")
def get_services():
    return load_json("services")

@app.post("/api/admin/services")
def create_service(svc: ServiceCreate, _=Depends(admin_required)):
    data = load_json("services")
    svc_id = str(uuid.uuid4())[:8]
    data.append({"id": svc_id, "title": svc.title, "desc": svc.description, "icon": svc.icon})
    save_json("services", data)
    return {"ok": True, "id": svc_id}

@app.delete("/api/admin/services/{svc_id}")
def delete_service(svc_id: str, _=Depends(admin_required)):
    data = load_json("services")
    data = [s for s in data if s["id"] != svc_id and s.get("title") != svc_id]
    save_json("services", data)
    return {"ok": True}

# ====== Artists ======
@app.get("/api/artists")
def get_artists():
    return load_json("artists")

@app.post("/api/admin/artists")
def create_artist(art: ArtistCreate, _=Depends(admin_required)):
    data = load_json("artists")
    art_id = str(uuid.uuid4())[:8]
    data.append({"id": art_id, "name": art.name, "streams": art.streams, "label": "ABE Music Group", "image": "🎤"})
    save_json("artists", data)
    return {"ok": True, "id": art_id}

@app.delete("/api/admin/artists/{art_id}")
def delete_artist(art_id: str, _=Depends(admin_required)):
    data = load_json("artists")
    data = [a for a in data if a["id"] != art_id and a["name"] != art_id]
    save_json("artists", data)
    return {"ok": True}

# ====== Contact ======
@app.post("/api/contact")
def submit_contact(req: ContactRequest):
    data = load_json("contacts")
    data.append({"name": req.name, "email": req.email, "service": req.service, "message": req.message, "created": datetime.now().isoformat()})
    save_json("contacts", data)
    return {"ok": True}

# ====== Portal Dashboard ======
@app.get("/api/portal/dashboard")
def get_dashboard(_=Depends(verify_token)):
    artists = load_json("artists")
    contacts = load_json("contacts")
    total_streams = sum(a.get("streams", 0) for a in artists)
    return {
        "total_streams": total_streams,
        "revenue": round(total_streams * 0.004, 2),
        "campaigns": len(contacts),
        "engagement": min(round(len(contacts) * 5 + 70, 1), 99.9),
    }

# ====== Health ======
@app.get("/api/health")
def health():
    return {
        "status": "ok",
        "services": {
            "webui": {"status": "online"},
            "abe_api": {"status": "online"},
        },
        "timestamp": datetime.now(timezone.utc).isoformat()
    }
