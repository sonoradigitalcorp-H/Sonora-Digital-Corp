# Engram → Obsidian live export
# Install: sudo ln -s __REPO__/infra/systemd/engram-obsidian-export.service /etc/systemd/system/
# Enable:  sudo systemctl enable --now engram-obsidian-export

[Unit]
Description=Engram Auto-Capture — Obsidian vault live export
Documentation=https://github.com/sonoradigitalcorp-H/sonora-digital-corp
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 __REPO__/scripts/engram_autocapture.py --obsidian-export __HOME__/Documents/sdc-brain-vault --watch --interval 300
WorkingDirectory=__REPO__
Restart=on-failure
RestartSec=10
User=mystic
Group=mystic

# Security hardening
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=default.target
