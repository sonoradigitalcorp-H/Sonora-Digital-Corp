[Unit]
Description=SDC Notifier Worker — Hermes-driven proactive notifications
After=network.target sdc-event-listener.service hermes-gateway.service
Requires=hermes-gateway.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/ubuntu/sonora-digital-corp/events/notifier.py
WorkingDirectory=/home/ubuntu/sonora-digital-corp
User=ubuntu
Restart=on-failure
RestartSec=5
Environment="NOTIFIER_POLL_INTERVAL=10"
Environment="HERMES_URL=http://localhost:8643"
Environment="OPENCLAW_URL=http://localhost:18789"
Environment="PYTHONPATH=/home/ubuntu/sonora-digital-corp"

[Install]
WantedBy=multi-user.target
