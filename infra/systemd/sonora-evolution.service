# Sonora Evolution — daily improvement cycle
# Install: sudo ln -s __REPO__/infra/systemd/sonora-evolution.service /etc/systemd/system/
# Enable:  sudo systemctl enable --now sonora-evolution.timer

[Unit]
Description=Sonora Evolution — daily improvement cycle (pattern detection, proposal generation, auto-apply)
Documentation=https://github.com/sonoradigitalcorp-H/sonora-digital-corp
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env PYTHONPATH=__REPO__ /usr/bin/python3 -m evolution.auto_evolve --daily
WorkingDirectory=__REPO__
User=mystic
Group=mystic

# Security hardening
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=default.target
