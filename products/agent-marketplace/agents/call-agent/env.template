# ═══════════════════════════════════════════════
# Call Agent — Environment Variables
# ═══════════════════════════════════════════════

# ─── Twilio (Telefonía) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+526621072254
TWILIO_REGION=mx1

# ─── Telnyx (Opcional, más barato) ───
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_PROFILE_ID=

# ─── LLM ───
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ─── Memoria ───
ENGRAM_PATH=/data/engram.db

# ─── Business Config ───
BUSINESS_NAME=
BUSINESS_HOURS=9:00-18:00
BUSINESS_TIMEZONE=America/Hermosillo
DEFAULT_LANGUAGE=es-MX

# ─── Lead Pipeline ───
LEAD_CRM_WEBHOOK=
LEAD_CAPTURE_SOURCE=phone
LEAD_MIN_SCORE=60
AUTO_SCHEDULE_APPOINTMENTS=true

# ─── Voice ───
TTS_VOICE=es-MX-DaliaNeural
TTS_RATE=-8%
TTS_PITCH=+5Hz
WAKE_WORD= mystica
SILENCE_TIMEOUT_MS=1500
