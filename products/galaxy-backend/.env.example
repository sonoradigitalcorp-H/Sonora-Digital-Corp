# Agent Galaxy Backend — Environment Variables

# LLM Provider (required)
OPENCODE_GO_API_KEY=sk-your-api-key-here
OPENROUTER_URL=https://openrouter.ai/api/v1

# Voice Pipeline (optional — defaults to preview mode)
GALAXY_STT_PROVIDER=deepseek_v4_flash
GALAXY_TTS_PROVIDER=deepseek_v4_flash
OMNIVOICE_URL=http://localhost:3900

# Onboarding
GALAXY_ONBOARDING_EXPIRY=600

# Storage (preview mode — SQLite)
GALAXY_DB_PATH=./state/galaxy_tenants.db
GALAXY_EVENT_LOG=./state/galaxy_events.jsonl

# Server
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=info
