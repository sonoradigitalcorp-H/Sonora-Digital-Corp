# Nathy Conta — Environment Variables
# Copiar a /etc/opencode/nathy-conta.env y llenar valores reales
# Este archivo NUNCA se commitea (está en .gitignore)

# Telegram
NATHY_BOT_TOKEN=pon-el-token-aqui

# Telegram channel
NATHY_CHANNEL_ID=@NathyConta

# MCP port
NATHY_MCP_PORT=8765

# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-tu-key-aqui
