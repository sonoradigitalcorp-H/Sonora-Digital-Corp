[Unit]
Description=Nathy Conta Telegram Bot
After=network.target

[Service]
Type=simple
User=mystic
WorkingDirectory=__REPO__/apps/nathy-bot
EnvironmentFile=/etc/opencode/nathy-conta.env
ExecStart=/usr/bin/python3 __REPO__/apps/nathy-bot/nathy_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
